rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMember(hid) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/households/$(hid)).data.members;
    }

    match /users/{uid} {
      // La pareja necesita poder leer el perfil del otro
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid;
    }

    match /invites/{code} {
      // Solo get (nunca list): el código inguessable es la credencial
      allow get: if signedIn();
      // getAfter: el invite se crea en el mismo batch que el hogar, así que
      // hay que validar contra el estado POSTERIOR al batch
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.auth.uid in
           getAfter(/databases/$(database)/documents/households/$(request.resource.data.householdId)).data.members;
      // Se borra junto con el hogar cuando el último integrante lo abandona
      allow delete: if isMember(resource.data.householdId);
    }

    match /households/{hid} {

      function isJoin() {
        // Un no-miembro se agrega EXACTAMENTE a sí mismo como 2.º integrante
        return !(request.auth.uid in resource.data.members)
          && resource.data.members.size() == 1
          && request.resource.data.members ==
             resource.data.members.concat([request.auth.uid])
          && request.resource.data.points[request.auth.uid] == 0
          && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['members', 'memberProfiles', 'points']);
      }

      function otherUid() {
        return resource.data.members[0] == request.auth.uid
          ? resource.data.members[1]
          : resource.data.members[0];
      }

      function otherBalanceUnchanged() {
        return resource.data.members.size() == 1
          || request.resource.data.points[otherUid()] == resource.data.points[otherUid()];
      }

      function isLeave() {
        // Un integrante se saca EXACTAMENTE a sí mismo (nunca al otro) y se
        // lleva su perfil y su balance; lo del otro queda intacto.
        return request.auth.uid in resource.data.members
          && request.resource.data.members ==
             resource.data.members.removeAll([request.auth.uid])
          && !(request.auth.uid in request.resource.data.points)
          && !(request.auth.uid in request.resource.data.memberProfiles)
          && otherBalanceUnchanged()
          && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['members', 'memberProfiles', 'points']);
      }

      function pointsDeltaOk() {
        // Solo el balance propio, sumas de hasta +500 (tareas) o restas (canjes),
        // nunca por debajo de cero, el del otro intocable.
        let mine = request.resource.data.points[request.auth.uid]
                 - resource.data.points[request.auth.uid];
        return mine <= 500
          && request.resource.data.points[request.auth.uid] >= 0
          && otherBalanceUnchanged();
      }

      function isMemberEdit() {
        return request.auth.uid in resource.data.members
          && request.resource.data.members == resource.data.members
          && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name', 'points', 'memberProfiles'])
          && pointsDeltaOk();
      }

      allow get: if signedIn() && request.auth.uid in resource.data.members;

      allow create: if signedIn()
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.points[request.auth.uid] == 0;

      allow update: if signedIn() && (isJoin() || isLeave() || isMemberEdit());

      // Si te quedaste solo, podés borrar el hogar (p.ej. lo creaste por error
      // y querés unirte al de tu pareja). Nunca se borra un hogar de a dos.
      allow delete: if signedIn() && resource.data.members == [request.auth.uid];

      // Historial de canjes: solo lectura y alta propia, nunca editar/borrar
      match /redemptions/{id} {
        allow read: if isMember(hid);
        allow create: if isMember(hid)
          && request.resource.data.redeemedBy == request.auth.uid;
      }

      // Resto de las subcolecciones del hogar: lectura/escritura de miembros.
      // redemptions se excluye: los match superpuestos se combinan con OR y
      // este catch-all anularía su inmutabilidad.
      match /{sub}/{doc} {
        allow read, write: if sub != 'redemptions' && isMember(hid);
      }
    }
  }
}
