# Copiá este archivo a .env.local y completá con los valores de tu proyecto Firebase
# (Consola de Firebase → Configuración del proyecto → General → Tus apps → App web)
VITE_FB_API_KEY=
# Usá <project-id>.web.app (el dominio donde va a vivir la app) para que el
# login por redirect funcione en la PWA instalada en iPhone.
VITE_FB_AUTH_DOMAIN=
VITE_FB_PROJECT_ID=
VITE_FB_APP_ID=
VITE_FB_SENDER_ID=

# Opcional: poné 1 para usar los emuladores locales de Firebase (auth + firestore)
VITE_USE_EMULATORS=
